# Prefix service environment variables
PORT=8080
# Rotate this key regularly and keep it in sync with Railway deployment settings.
API_KEY=<change-me>
REQUEST_LIMIT_PER_MIN=120
BODY_LIMIT=2mb
CORS_ORIGIN=*
METRICS_ENABLED=false
FETCH_TIMEOUT_MS=7000
URL_CACHE_TTL_MS=30000
URL_CACHE_MAX=64
IDEMPOTENCY_CACHE_MAX=256

# Polar billing
POLAR_ACCESS_TOKEN=
POLAR_API_BASE_URL=https://api.polar.sh
POLAR_SANDBOX_ACCESS_TOKEN=
POLAR_SANDBOX_API_BASE_URL=https://sandbox-api.polar.sh
POLAR_CREDITS_METER_ID=
POLAR_SANDBOX_CREDITS_METER_ID=
